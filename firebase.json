{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "dek-mit-live-catalogue.csv"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
